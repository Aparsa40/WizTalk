# OPENROUTER_API_KEY: Required for OpenRouter text/voice-chat and TTS routes.
# Keep the real key only in your local .env or deployment environment.
# Never commit the real API key to Git.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# HF_TOKEN: Required for Hugging Face text/voice-chat model slots.
# Create a fine-grained Hugging Face token with Inference Providers access.
# Keep the real token only in your local .env or deployment environment.
HF_TOKEN="YOUR_HUGGINGFACE_TOKEN"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
