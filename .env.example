# OPENROUTER_API_KEY: Required for OpenRouter text/voice-chat and TTS routes.
# Keep the real key only in your local .env or deployment environment.
# Never commit the real API key to Git.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# HUGGING_FACE_TOKEN: Hugging Face token for text/voice-chat model slots.
# HF_TOKEN is also accepted for compatibility with Hugging Face tooling.
# Create a fine-grained token with the required Inference Providers access.
# Keep the real token only in your local .env or deployment environment.
HUGGING_FACE_TOKEN="YOUR_HUGGINGFACE_TOKEN"
# HF_TOKEN="YOUR_HUGGINGFACE_TOKEN"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
